import Lean.Elab.Tactic.Omega

namespace ExactLocalCoalition

/-!
Formal checks for the finite four-expert coalition algebra used by the
GPT-OSS exact subset-utility paper.

The empirical KL values are real-valued measurements.  The identities below
are purely linear coefficient identities, so it is enough to verify them over
`Int`: the same identities hold over any additive setting in which the integer
coefficients act in the usual way (in particular over `Real`).
-/

/-- Two-player Boolean-lattice Möbius reconstruction. -/
theorem pair_mobius_reconstruction
    (d0 d1 d2 d12 : Int) :
    d12 =
      d0 +
      (d1 - d0) +
      (d2 - d0) +
      (d12 - d1 - d2 + d0) := by
  omega

/-- Three-player Boolean-lattice Möbius reconstruction. -/
theorem triple_mobius_reconstruction
    (d0 d1 d2 d3 d12 d13 d23 d123 : Int) :
    d123 =
      d0 +
      (d1 - d0) + (d2 - d0) + (d3 - d0) +
      (d12 - d1 - d2 + d0) +
      (d13 - d1 - d3 + d0) +
      (d23 - d2 - d3 + d0) +
      (d123 - d12 - d13 - d23 + d1 + d2 + d3 - d0) := by
  omega

/--
Four-player Boolean-lattice Möbius reconstruction.  This is the exact algebra
behind reconstructing the 16-value local coalition game from its interaction
coefficients.
-/
theorem four_player_mobius_reconstruction
    (d0 d1 d2 d3 d4
     d12 d13 d14 d23 d24 d34
     d123 d124 d134 d234 d1234 : Int) :
    d1234 =
      d0 +
      (d1 - d0) + (d2 - d0) + (d3 - d0) + (d4 - d0) +
      (d12 - d1 - d2 + d0) +
      (d13 - d1 - d3 + d0) +
      (d14 - d1 - d4 + d0) +
      (d23 - d2 - d3 + d0) +
      (d24 - d2 - d4 + d0) +
      (d34 - d3 - d4 + d0) +
      (d123 - d12 - d13 - d23 + d1 + d2 + d3 - d0) +
      (d124 - d12 - d14 - d24 + d1 + d2 + d4 - d0) +
      (d134 - d13 - d14 - d34 + d1 + d3 + d4 - d0) +
      (d234 - d23 - d24 - d34 + d2 + d3 + d4 - d0) +
      (d1234 - d123 - d124 - d134 - d234
        + d12 + d13 + d14 + d23 + d24 + d34
        - d1 - d2 - d3 - d4 + d0) := by
  omega

/--
The error of the first-order (additive singleton) approximation at the full
four-player coalition is exactly the sum of pair, triple, and four-way Möbius
interaction terms.
-/
theorem first_order_error_is_higher_order_interaction
    (d0 d1 d2 d3 d4
     d12 d13 d14 d23 d24 d34
     d123 d124 d134 d234 d1234 : Int) :
    d1234 -
      (d0 + (d1 - d0) + (d2 - d0) + (d3 - d0) + (d4 - d0)) =
      (d12 - d1 - d2 + d0) +
      (d13 - d1 - d3 + d0) +
      (d14 - d1 - d4 + d0) +
      (d23 - d2 - d3 + d0) +
      (d24 - d2 - d4 + d0) +
      (d34 - d3 - d4 + d0) +
      (d123 - d12 - d13 - d23 + d1 + d2 + d3 - d0) +
      (d124 - d12 - d14 - d24 + d1 + d2 + d4 - d0) +
      (d134 - d13 - d14 - d34 + d1 + d3 + d4 - d0) +
      (d234 - d23 - d24 - d34 + d2 + d3 + d4 - d0) +
      (d1234 - d123 - d124 - d134 - d234
        + d12 + d13 + d14 + d23 + d24 + d34
        - d1 - d2 - d3 - d4 + d0) := by
  omega

/--
For player 1 in a four-player game, the classical Shapley permutation formula
is identical to the Möbius-interaction formula

  phi_1 = sum_{T containing 1} mu(T) / |T|.

To avoid division in the formal statement, both sides are multiplied by 12.
-/
theorem shapley_one_equals_mobius_allocation_scaled
    (d0 d1 d2 d3 d4
     d12 d13 d14 d23 d24 d34
     d123 d124 d134 d234 d1234 : Int) :
    3 * (d1 - d0) +
      (d12 - d2) + (d13 - d3) + (d14 - d4) +
      (d123 - d23) + (d124 - d24) + (d134 - d34) +
      3 * (d1234 - d234) =
    12 * (d1 - d0) +
      6 * ((d12 - d1 - d2 + d0) +
           (d13 - d1 - d3 + d0) +
           (d14 - d1 - d4 + d0)) +
      4 * ((d123 - d12 - d13 - d23 + d1 + d2 + d3 - d0) +
           (d124 - d12 - d14 - d24 + d1 + d2 + d4 - d0) +
           (d134 - d13 - d14 - d34 + d1 + d3 + d4 - d0)) +
      3 * (d1234 - d123 - d124 - d134 - d234
        + d12 + d13 + d14 + d23 + d24 + d34
        - d1 - d2 - d3 - d4 + d0) := by
  omega

/-!
An exact Shapley value is an attribution, not a sufficient statistic for the
best fixed-cardinality coalition.  The following concrete game is generated by
Möbius terms mu({1}) = 100, mu({2}) = 2, mu({2,3}) = 180, all others zero.
The exact Shapley ranking is 1 > 2 > 3 > 4, but the best two-player coalition
is {2,3}, not the top-two Shapley coalition {1,2}.
-/

/-- The scaled (12 * phi) Shapley values for the counterexample. -/
theorem exact_shapley_counterexample_values :
    let d0 : Int := 0
    let d1 : Int := 100
    let d2 : Int := 2
    let d3 : Int := 0
    let d4 : Int := 0
    let d12 : Int := 102
    let d13 : Int := 100
    let d14 : Int := 100
    let d23 : Int := 182
    let d24 : Int := 2
    let d34 : Int := 0
    let d123 : Int := 282
    let d124 : Int := 102
    let d134 : Int := 100
    let d234 : Int := 182
    let d1234 : Int := 282
    let phi1 := 3 * (d1 - d0) +
      (d12 - d2) + (d13 - d3) + (d14 - d4) +
      (d123 - d23) + (d124 - d24) + (d134 - d34) +
      3 * (d1234 - d234)
    let phi2 := 3 * (d2 - d0) +
      (d12 - d1) + (d23 - d3) + (d24 - d4) +
      (d123 - d13) + (d124 - d14) + (d234 - d34) +
      3 * (d1234 - d134)
    let phi3 := 3 * (d3 - d0) +
      (d13 - d1) + (d23 - d2) + (d34 - d4) +
      (d123 - d12) + (d134 - d14) + (d234 - d24) +
      3 * (d1234 - d124)
    let phi4 := 3 * (d4 - d0) +
      (d14 - d1) + (d24 - d2) + (d34 - d3) +
      (d124 - d12) + (d134 - d13) + (d234 - d23) +
      3 * (d1234 - d123)
    phi1 = 1200 ∧ phi2 = 1104 ∧ phi3 = 1080 ∧ phi4 = 0 := by
  decide

/-- Top-two Shapley ranking is not the cardinality-two utility optimum. -/
theorem exact_shapley_ranking_not_subset_optimum :
    (1200 : Int) > 1104 ∧ 1104 > 1080 ∧ 1080 > 0 ∧
    (182 : Int) > 102 ∧ 182 > 100 ∧ 182 > 2 ∧ 182 > 0 := by
  decide

end ExactLocalCoalition
